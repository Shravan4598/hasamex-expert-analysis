# ============================================================
# Hasamex Expert Analysis - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------

# Google Gemini API key.
# Get your key from Google AI Studio.
GOOGLE_API_KEY=

# ------------------------------------------------------------
# LLM Configuration
# ------------------------------------------------------------

# Main generative model used for grounded analysis.
LLM_MODEL=gemini-2.5-flash

# Temperature should remain low for factual, grounded answers.
LLM_TEMPERATURE=0.1

# Maximum output tokens for generated responses.
LLM_MAX_OUTPUT_TOKENS=2048


# ------------------------------------------------------------
# Embedding Configuration
# ------------------------------------------------------------

# Local sentence-transformer model used for semantic retrieval.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of retrieved candidates before reranking.
RETRIEVAL_TOP_K=8

# Number of evidence chunks retained after reranking.
RERANK_TOP_K=5


# ------------------------------------------------------------
# Chunking Configuration
# ------------------------------------------------------------

# Target number of characters in a transcript chunk.
CHUNK_SIZE=1200

# Number of overlapping characters between adjacent chunks.
CHUNK_OVERLAP=200


# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------

APP_NAME=Hasamex Expert Analysis
APP_ENV=development
LOG_LEVEL=INFO

# Directory containing the original transcript files.
RAW_DATA_DIR=data/raw

# Directory containing processed transcript data.
PROCESSED_DATA_DIR=data/processed

# Directory used for the local FAISS index.
VECTOR_STORE_DIR=storage/vector_store


# ------------------------------------------------------------
# Retrieval Configuration
# ------------------------------------------------------------

# Minimum semantic similarity required for an evidence candidate.
MIN_RETRIEVAL_SCORE=0.02

# Minimum evidence coverage required before generating an answer.
MIN_EVIDENCE_COVERAGE=0.50


# ------------------------------------------------------------
# Streamlit Configuration
# ------------------------------------------------------------

STREAMLIT_PAGE_TITLE=Hasamex Expert Analysis
STREAMLIT_PAGE_ICON=🔎